# Clean-room install test — validates headless bootstrap on fresh Ubuntu.
# Usage: docker build -f tests/Dockerfile.test -t dotfiles-test .
#
# Catches regressions that --dry-run misses (e.g. chezmoi apply without init).

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    GIT_NAME="CI Test" \
    GIT_EMAIL="ci@example.com" \
    DOTFILES_NONINTERACTIVE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates sudo python3 zsh \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://just.systems/install.sh | bash -s -- --to /usr/local/bin

RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER testuser
WORKDIR /home/testuser
ENV HOME=/home/testuser

COPY --chown=testuser:testuser . /home/testuser/dotfiles

# Fast checks before the long install (fail early)
RUN cd dotfiles && bash install.sh profiles 2>&1 | grep -q "minimal"
RUN cd dotfiles && just --list 2>&1 | grep -q "check"
RUN zsh -n dotfiles/.zshrc
RUN bash -n dotfiles/install.sh

# Real headless minimal install (not dry-run). Fail the layer if install fails
# (plain `| tee` would mask a non-zero exit under /bin/sh).
RUN cd dotfiles && bash -o pipefail -c \
    'bash install.sh install minimal --headless 2>&1 | tee /tmp/install.log'

# Assert $HOME converged — the failure mode that dry-run never saw
RUN test -f "$HOME/.zshrc" || (echo "FAIL: ~/.zshrc missing" && exit 1)
RUN test -f "$HOME/.config/chezmoi/chezmoi.toml" || \
    (echo "FAIL: chezmoi.toml missing (init never ran)" && cat /tmp/install.log && exit 1)
RUN test -f "$HOME/.gitconfig" || (echo "FAIL: ~/.gitconfig missing" && exit 1)
RUN grep -q "CI Test" "$HOME/.gitconfig" || \
    (echo "FAIL: git user.name not applied" && cat "$HOME/.gitconfig" && exit 1)
RUN grep -q "name = \"CI Test\"" "$HOME/.config/chezmoi/chezmoi.toml"

RUN echo "=== CLEAN-ROOM HEADLESS INSTALL: ALL PASSED ==="
CMD ["echo", "Clean-room test passed"]
