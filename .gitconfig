# User Configuration
# ==================
# User-specific settings (name, email, signing key) should be in ~/.gitconfig.local
# This file is NOT tracked in dotfiles for privacy/security.
#
# To set up:
#   git config --global user.name "Your Name"
#   git config --global user.email "your.email@example.com"
#
# Or copy the template:
#   cp ~/.dotfiles/git/gitconfig.local.template ~/.gitconfig.local

[core]
    editor = nvim
    autocrlf = input
    excludesfile = ~/.gitignore_global
	hooksPath = /dev/null

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[merge]
    tool = nvim
    conflictstyle = diff3

[diff]
    tool = nvim
    algorithm = histogram     # Clearer diffs on moved/edited lines
    colorMoved = plain        # Highlight moved blocks in diffs
    mnemonicPrefix = true     # More intuitive refs in diff output

[commit]
    verbose = true            # Include diff in commit message template

[column]
    ui = auto                 # Output in columns when possible

[branch]
    sort = -committerdate     # Sort branches by most recent commit

[tag]
    sort = -version:refname   # Sort version numbers naturally

[rerere]
    enabled = true            # Record and reuse conflict resolutions
    autoupdate = true         # Apply stored resolutions automatically

[alias]
    st = status
    co = checkout
    br = branch
    cm = commit
    lg = log --oneline --graph --decorate --all
    unstage = reset HEAD --
    last = log -1 HEAD
    visual = !gitk
    
[color]
    ui = auto
    
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
    
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
    
[color "status"]
    added = yellow
    changed = green
    untracked = cyan

# Include user-specific configurations
[include]
    path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[user]
	name = Bogdan Veliscu
	email = bogdan.veliscu@outlook.com
