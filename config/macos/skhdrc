# Managed by dotfiles — config/macos/skhdrc → ~/.skhdrc
# Requires: skhd (Brewfile) + Accessibility permission + skhd --start-service

# ⌥⌘U / ⌥⌘H → fixed input; ⌥⌘I → toggle USB-C ↔ HDMI
alt + cmd - u : "$HOME/.config/macos/scripts/switch-display.sh" usb-c
alt + cmd - h : "$HOME/.config/macos/scripts/switch-display.sh" hdmi
alt + cmd - i : "$HOME/.config/macos/scripts/switch-display.sh" toggle
