# Brewfile - macOS packages
# Core development tools for the FORGE portfolio

# =============================================================================
# Core Shell & Terminal
# =============================================================================
brew "zsh"                  # Modern shell
brew "tmux"                 # Terminal multiplexer
brew "starship"             # Cross-shell prompt

# =============================================================================
# Version Control & Git Tools
# =============================================================================
brew "git"                  # Version control
brew "gh"                   # GitHub CLI
brew "git-delta"            # Better git diffs

# =============================================================================
# Modern CLI Replacements
# =============================================================================
brew "fzf"                  # Fuzzy finder
brew "ripgrep"              # Fast grep (rg)
brew "fd"                   # Fast find
brew "bat"                  # Better cat
brew "eza"                  # Better ls
brew "zoxide"               # Smart cd
brew "duf"                  # Better df
brew "btop"                 # Better top

# =============================================================================
# Text Processing
# =============================================================================
brew "jq"                   # JSON processor
brew "yq"                   # YAML processor
brew "glow"                 # Markdown renderer

# =============================================================================
# Editors
# =============================================================================
brew "neovim"               # Modern vim

# =============================================================================
# Development Languages & Runtimes
# =============================================================================
brew "mise"                 # Universal version manager (replaces asdf/nvm/pyenv)
brew "uv"                   # Fast Python package manager

# =============================================================================
# Database Tools
# =============================================================================
brew "postgresql@16"        # PostgreSQL client
brew "redis"                # Redis client

# =============================================================================
# API & Web Tools
# =============================================================================
brew "httpie"               # HTTP client
brew "curl"                 # Standard HTTP tool
brew "wget"                 # File downloader

# =============================================================================
# Container & Infrastructure
# =============================================================================
cask "orbstack"             # Modern Docker/Linux VM (fast, lightweight)
# brew "docker"             # Uncomment if Orbstack not preferred
# brew "colima"             # Lightweight Docker runtime alternative

# =============================================================================
# Terminal & Editors
# =============================================================================
cask "ghostty"              # Fast, native terminal emulator
# cask "cursor"             # AI code editor (installed via manual download)
# cask "warp"               # Modern terminal alternative

# =============================================================================
# AI & LLM Tools (optional)
# =============================================================================
# brew "ollama"             # Local LLM runtime
# brew "llm"                # CLI for LLMs

# =============================================================================
# Productivity & Knowledge Management
# =============================================================================
cask "obsidian"             # Markdown-based knowledge base
cask "notion"               # Team wiki & project management
cask "p4v"                  # Perforce visual client
# cask "raycast"            # Better Spotlight

# =============================================================================
# Fonts
# =============================================================================
cask "font-jetbrains-mono-nerd-font"
cask "font-fira-code-nerd-font"
cask "font-meslo-lg-nerd-font"

