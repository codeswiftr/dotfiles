{
  "title": "Monitor input switching (m1ddc)",
  "rules": [
    {
      "description": "Monitor input: USB-C (⌥⌘U) / HDMI (⌥⌘H)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "u",
            "modifiers": {
              "mandatory": ["left_option", "left_command"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "shell_command": "/bin/bash \"$HOME/raycast-scripts/switch-monitor-usb-c.sh\""
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": {
              "mandatory": ["left_option", "left_command"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "shell_command": "/bin/bash \"$HOME/raycast-scripts/switch-monitor-hdmi.sh\""
            }
          ]
        }
      ]
    }
  ]
}
