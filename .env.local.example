# Copy this to ~/.env.local (never commit that file — it's gitignored)
# This file documents all machine-local secrets and overrides.

# =============================================================================
# AI Agent API Keys (required for AI features)
# =============================================================================
# export ANTHROPIC_API_KEY="sk-ant-..."        # Claude / claude-code
# export OPENAI_API_KEY="sk-..."               # Aider + GPT-4, OpenAI tools
# export GEMINI_API_KEY="..."                  # Gemini CLI
# export GITHUB_TOKEN="ghp_..."               # GitHub Copilot, gh CLI auth

# Default AI agent when running `ai` with no arguments: claude | aider | opencode
# export AI_DEFAULT_AGENT="claude"

# =============================================================================
# Dotfiles behaviour
# =============================================================================
# Override dotfiles install profile for this machine (minimal | standard | full)
# export DOTFILES_PROFILE=full

# AI security gate (true = enforce; false = permissive)
# export AI_SECURITY_ENABLED=true

# =============================================================================
# FORGE configuration (machine-specific — delete if not using)
# =============================================================================
# export COMMAND_CENTER_URL="https://your-hub.ts.net"
# export FORGE_WEBHOOK_TOKEN="your-token-here"
# export FORGE_ROOT="$HOME/work/forge-mono"
# export FORGE_API_URL="http://your-hub:8081"

# =============================================================================
# OpenClaw relay (used by claw-relay alias in .zshrc — delete if not using)
# =============================================================================
# export OPENCLAW_GATEWAY_TOKEN="your-token-here"
# export OPENCLAW_RELAY_HOST="your-node.ts.net"
# export OPENCLAW_DISPLAY_NAME="my-node"

# =============================================================================
# Machine-specific overrides
# =============================================================================
# export PATH="$HOME/custom/bin:$PATH"
