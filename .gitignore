# Machine-local secrets (never commit)
.env.local
.env.*.local
*.local.toml
mise.lock

# Machine-specific config (paths differ per platform)
.gitconfig

# Legacy path (canonical is config/starship.toml)
.config/

# bin/ policy: only repo-owned scripts are tracked (dot, ai, cursor, viman,
# dotfiles-tutor, tmux-versions). Everything else is machine-local.
bin/*
!bin/dot
!bin/ai
!bin/cursor
!bin/viman
!bin/dotfiles-tutor
!bin/tmux-versions
!bin/_agent
!bin/_claude
!bin/_codex
!bin/_kimi
!bin/_gemini
!bin/_pi
!bin/_opencode
!bin/_cursor
!bin/_amp
!bin/_minimax
!bin/_glm
!bin/agent-restart

# Test results (ephemeral artifacts, never commit)
tests/results/

# Generated artifacts
.pytest_cache/
*.pyc
__pycache__/
.venv/
.coverage
.mypy_cache/

# Neovim runtime files
.nvimlog
config/nvim/.nvim-tier
config/nvim/lazy-lock.json
config/zsh/secrets.zsh

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath

# Build outputs
node_modules/
dist/
build/
*.egg-info/
.eggs/

# Environment files
.env
.envrc

# Neovim generated
config/nvim/nvim

# Local forge experiments
.forge/
.config/systemd/
scripts/cleanup-claude.sh

# Review artifacts (working files, not committed)
reviews/

# Plan (working document)
plan.md
nvim.log

# Machine-local fleet enable marker
config/profiles/fleet/.enabled
