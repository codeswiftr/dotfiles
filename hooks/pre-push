#!/usr/bin/env bash
# Global pre-push: repo pre-commit pre-push stage, else light secret path scan.
set -euo pipefail
# shellcheck source=hooks/_common.sh
source "$(cd "$(dirname "$0")" && pwd)/_common.sh"

remote="${1:-origin}"
root="$(hooks_repo_root)"
[[ -n "$root" ]] || exit 0
cd "$root"

if [[ -f .pre-commit-config.yaml || -f .pre-commit-config.yml ]]; then
  hooks_run_precommit pre-push
  exit $?
fi

# Fallback: block obvious credential filenames in the push range
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue
  range="$remote_sha..$local_sha"
  [[ "$remote_sha" == "$zero" ]] && range="$local_sha"
  if git diff --name-only "$range" 2>/dev/null | grep -qiE '(^|/)\.env$|\.pem$|id_rsa|credentials\.json|secrets\.(ya?ml|json)'; then
    echo "pre-push: refusing push — looks like credential files in $range" >&2
    echo "  remote=$remote ref=$local_ref" >&2
    exit 1
  fi
done
exit 0
