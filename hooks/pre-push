#!/bin/bash

# Dotfiles Pre-push Hook — fast checks only (<15s)
#
# Heavy validation (full test suite, installation profiles, documentation,
# cross-platform compatibility, version consistency, docs index freshness)
# is handled by CI and `dot verify`. This hook runs only quick, critical
# gatekeeping: security compliance, commit hygiene, and repo size warnings.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Determine the repository root robustly. For global hooks, the hooks dir is not the repo.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
remote="$1"
url="$2"
EXIT_CODE=0

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[PASS]${NC} $1"
}

log_error() {
    echo -e "${RED}[FAIL]${NC} $1"
    EXIT_CODE=1
}

log_warning() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

check_security_compliance() {
    log_info "Checking security compliance..."

    # Only scan tracked files to avoid false positives from local artifacts
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        log_warning "Not inside a git repo; skipping security checks"
        return 0
    fi

    # Prepare list of tracked files (respect .gitignore)
    TRACKED_FILES=$(git ls-files)

    # Helper to test if any tracked file matches a glob
    has_tracked_match() {
        local glob="$1"
        for f in $TRACKED_FILES; do
            [[ $f == $glob ]] && return 0
        done
        return 1
    }

    # Check for sensitive tracked files that shouldn't be committed
    local sensitive_files=(
        ".env"
        ".env.local"
        ".env.production"
        "id_rsa"
        "id_ed25519"
        "*.pem"
        "*.p12"
        "*.key"
        "secrets.yaml"
        "config.json"
    )

    local found_sensitive=false
    for pattern in "${sensitive_files[@]}"; do
        if has_tracked_match "$pattern"; then
            log_error "Sensitive tracked file present: $pattern"
            found_sensitive=true
        fi
    done

    if [[ "$found_sensitive" == "false" ]]; then
        log_success "No sensitive tracked files detected"
    fi

    # Check for hardcoded credentials (warning only — dedicated scanners run in CI)
    local credential_patterns=(
        # Only flag likely hardcoded assignments (exclude comments)
        "^[^#]*password\s*=\s*['\"][^'\"]+['\"]"
        "^[^#]*secret\s*=\s*['\"][^'\"]+['\"]"
        "^[^#]*token\s*=\s*['\"][^'\"]+['\"]"
        "^[^#]*api[_-]?key\s*=\s*['\"][^'\"]+['\"]"
    )

    local found_credentials=false
    # Use git grep to search only tracked files and limit to common config/code types
    for pattern in "${credential_patterns[@]}"; do
        if git grep -E -I --quiet "$pattern" -- \
            '*.sh' '*.zsh' '*.yaml' '*.yml' '*.json' '*.env' '*.cfg' '*.conf' '*.toml' \
            . \
            ':(exclude)docs/**' \
            ':(exclude)tests/**' \
            ':(exclude)leanvibe-backend/leanvibe-frontend/**' \
            ':(exclude)leanvibe-ios/**' \
            ':(exclude)**/*example*' \
            ':(exclude)**/*sample*' \
            ':(exclude)**/*spec*'; then
            # Print one sample for developer context
            local sample
            sample=$(git grep -nE "$pattern" -- \
              '*.sh' '*.zsh' '*.yaml' '*.yml' '*.json' '*.env' '*.cfg' '*.conf' '*.toml' \
              2>/dev/null | head -1 || true)
            log_warning "Potential hardcoded credential pattern matched: $pattern"
            if [[ -n "$sample" ]]; then echo "$sample"; fi
            # Treat as warning to reduce false positives; dedicated secret scanners run elsewhere
        fi
    done

    log_success "Secret pattern scan completed"
}

check_commit_history() {
    log_info "Checking commit history..."

    # Check for commits that might indicate issues
    local recent_commits
    recent_commits=$(git log --oneline -10)

    # Check for fixup commits
    if echo "$recent_commits" | grep -q "fixup!"; then
        log_warning "Fixup commits detected - consider squashing"
    fi

    # Check for WIP commits
    if echo "$recent_commits" | grep -qi "wip\|work in progress"; then
        log_warning "WIP commits detected - ensure they're ready for push"
    fi

    # Check for merge commits on feature branches
    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD)

    if [[ "$current_branch" != "master" ]] && [[ "$current_branch" != "main" ]]; then
        if echo "$recent_commits" | grep -q "Merge branch"; then
            log_warning "Merge commits on feature branch - consider rebasing"
        fi
    fi

    log_success "Commit history check completed"
}

check_repository_size() {
    log_info "Checking repository size..."

    # Check repository size
    local repo_size
    repo_size=$(du -sh . 2>/dev/null | cut -f1)

    log_info "Repository size: $repo_size"

    # Check for large files (warning only — does not block push)
    local large_files
    large_files=$(find . -type f -size +10M -not -path "./.git/*" 2>/dev/null)

    if [[ -n "$large_files" ]]; then
        log_warning "Large files detected:"
        echo "$large_files"
        echo "Consider using Git LFS for large files"
    else
        log_success "No large files detected"
    fi
}

# Main execution
main() {
    log_info "Starting pre-push validation for remote: $remote"
    echo

    # Change to repository root
    cd "$REPO_ROOT"

    # Security checks (blocks push on sensitive files)
    check_security_compliance
    echo

    # Commit history
    check_commit_history
    echo

    # Repository size warnings
    check_repository_size
    echo

    # Summary
    if [[ $EXIT_CODE -eq 0 ]]; then
        log_success "All pre-push validations passed!"
        echo "Ready to push to $remote"
    else
        log_error "Pre-push validation failed!"
        echo ""
        echo "Please fix the issues above before pushing."
        echo "For full validation run: dot verify"
    fi

    exit $EXIT_CODE
}

# Run main function
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
