#!/usr/bin/env bash
# Global commit-msg: pre-commit commit-msg stage, else light conventional-commit check.
set -euo pipefail
# shellcheck source=hooks/_common.sh
source "$(cd "$(dirname "$0")" && pwd)/_common.sh"

COMMIT_MSG_FILE="${1:-}"
[[ -n "$COMMIT_MSG_FILE" && -f "$COMMIT_MSG_FILE" ]] || exit 0

root="$(hooks_repo_root)"
[[ -n "$root" ]] || exit 0
cd "$root"

if [[ -f .pre-commit-config.yaml || -f .pre-commit-config.yml ]]; then
  hooks_run_precommit commit-msg --commit-msg-filename "$COMMIT_MSG_FILE"
  exit 0
fi

# Fallback when the repo has no pre-commit config
msg="$(head -n1 "$COMMIT_MSG_FILE")"
[[ "$msg" =~ ^Merge|^Revert|^fixup!|^squash! ]] && exit 0
if [[ ${#msg} -lt 10 ]]; then
  echo "commit-msg: subject too short (min 10 chars)" >&2
  exit 1
fi
if [[ ${#msg} -gt 72 ]]; then
  echo "commit-msg: subject too long (max 72 chars)" >&2
  exit 1
fi
if [[ ! "$msg" =~ ^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?:\ .+ ]]; then
  echo "commit-msg: prefer conventional commits — type(scope): description" >&2
  echo "  got: $msg" >&2
fi
exit 0
