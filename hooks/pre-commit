#!/usr/bin/env bash
# Global pre-commit: quick secret scan + repo pre-commit framework (if configured).
set -euo pipefail
# shellcheck source=hooks/_common.sh
source "$(cd "$(dirname "$0")" && pwd)/_common.sh"

root="$(hooks_repo_root)"
[[ -n "$root" ]] || exit 0
cd "$root"

hooks_scan_staged_secrets

if [[ -f .pre-commit-config.yaml || -f .pre-commit-config.yml ]]; then
  hooks_run_precommit pre-commit
fi
