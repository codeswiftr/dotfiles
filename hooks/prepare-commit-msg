#!/usr/bin/env bash
# Global prepare-commit-msg: only the pre-commit framework stage when configured.
set -euo pipefail
# shellcheck source=hooks/_common.sh
source "$(cd "$(dirname "$0")" && pwd)/_common.sh"

COMMIT_MSG_FILE="${1:-}"
root="$(hooks_repo_root)"
[[ -n "$root" && -n "$COMMIT_MSG_FILE" ]] || exit 0
cd "$root"

if [[ -f .pre-commit-config.yaml || -f .pre-commit-config.yml ]]; then
  hooks_run_precommit prepare-commit-msg --commit-msg-filename "$COMMIT_MSG_FILE" || true
fi
exit 0
