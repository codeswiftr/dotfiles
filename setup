#!/usr/bin/env bash
# Memorable entrypoint after clone:  ./setup
# Same as: ./install.sh install standard
# Usage: ./setup [minimal|standard]
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-}" in
  -h|--help|help)
    cat <<'EOF'
Usage: ./setup [profile]

Profiles: minimal | standard (default)

Same as: ./install.sh install <profile>

Fresh machine (no clone yet):
  curl -fsSL https://raw.githubusercontent.com/codeswiftr/dotfiles/main/scripts/bootstrap.sh | bash
EOF
    exit 0
    ;;
esac

profile="${1:-standard}"
case "$profile" in
  full|ai_focused)
    echo "Note: profile '$profile' retired — using 'standard'" >&2
    profile=standard
    ;;
esac
exec bash "$ROOT/install.sh" install "$profile"
