#compdef dot

# Zsh completions for DOT CLI (kept in sync with bin/dot)

_dot() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-v --version)'{-v,--version}'[Show version]' \
        '(-m --machine)'{-m,--machine}'[Machine-readable JSON]' \
        '1:command:_dot_commands' \
        '*::arg:->args'

    case $state in
        args)
            case $words[1] in
                check|doctor|health)
                    _arguments \
                        '--fix[Fix issues when possible]' \
                        '--detailed[Extra checks]' \
                        '(-m --machine)'{-m,--machine}'[JSON output]'
                    ;;
                update)
                    _arguments \
                        '--self[Pull + relink only]' \
                        '--tools[Upgrade tools only]' \
                        '--reload[exec zsh after update]' \
                        '--yes[Auto-confirm]' \
                        '*:tool:(herdr claude codex kimi opencode cursor pi brew npm uv mise nvim)'
                    ;;
                test|testing)
                    _values 'suite' all smoke infra
                    ;;
                setup|init)
                    _arguments '--force[Force reinstall]' '--verbose[Verbose]'
                    ;;
                install)
                    _message 'tool or group from config/tools.yaml'
                    ;;
                restart|reload|docs|security|git|ai|config)
                    _message 'see: dot --help'
                    ;;
            esac
            ;;
    esac
}

_dot_commands() {
    local commands
    commands=(
        'setup:First-time / force setup'
        'check:Health validation'
        'update:Pull, relink, upgrade tools'
        'reload:Reload Herdr / mise'
        'restart:Herdr workspace + agent status'
        'test:Run bats suite'
        'install:Install tool or group'
        'doctor:Alias for check --fix'
        'docs:Documentation helpers'
        'security:Security scans'
        'git:Git helpers'
        'ai:AI helper'
        'config:Config helpers'
    )
    _describe 'commands' commands
}

_dot "$@"
