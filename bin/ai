#!/bin/bash
# ============================================================================
# Unified AI Agent Launcher
# Single entry point for all agentic coding CLI tools
# ============================================================================

set -e

export DOTFILES_MODE="${DOTFILES_MODE:-agent}"
export DOTFILES_AGENT_SAFE="${DOTFILES_AGENT_SAFE:-1}"

# Ensure npm global packages are in PATH (for pi, codex, etc.)
if [[ -d "$HOME/.npm-global/bin" ]]; then
    export PATH="$HOME/.npm-global/bin:$PATH"
fi

# Ensure mise shims are in PATH (for node, etc.)
if [[ -d "$HOME/.local/share/mise/shims" ]]; then
    export PATH="$HOME/.local/share/mise/shims:$PATH"
fi

# Ensure Cursor Agent is in PATH
if [[ -d "$HOME/.cursor-agent/bin" ]]; then
    export PATH="$HOME/.cursor-agent/bin:$PATH"
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Default agent (can be overridden with AI_DEFAULT_AGENT env var)
DEFAULT_AGENT="${AI_DEFAULT_AGENT:-claude}"

show_help() {
    cat << 'EOF'
🤖 AI Agent Launcher - Unified interface for agentic coding tools

USAGE:
    ai [agent] [args...]
    ai --list
    ai --help

AGENTS:
    claude, c      Claude Code (Anthropic) - Primary agentic coding
    cursor, agent  Cursor Agent - Headless AI coding agent
    aider, a       Aider - Git-aware pair programming
    opencode, oc   OpenCode - Open source AI agent
    amp            Amp - Sourcegraph's coding agent
    pi             Pi - Terminal-native coding agent
    gemini, g      Gemini CLI - Google's AI
    kimi           Kimi - Moonshot AI coding assistant
    codex, cx      Codex - OpenAI's coding assistant

EXAMPLES:
    ai                     # Launch default agent (claude)
    ai claude              # Launch Claude Code
    ai aider --model gpt4  # Launch Aider with specific model
    ai agent -p "explain"  # Cursor Agent in print mode
    ai --list              # Show installed agents

ENVIRONMENT:
    AI_DEFAULT_AGENT       Set default agent (default: claude)

EOF
}

list_agents() {
    echo -e "${CYAN}Installed AI Agents:${NC}"
    echo ""

    local agents=(
        "claude:Claude Code:claude --version"
        "agent:Cursor Agent:agent --version"
        "aider:Aider:aider --version"
        "opencode:OpenCode:opencode --version"
        "amp:Amp:amp --version"
        "pi:Pi:pi --version"
        "gemini:Gemini:gemini --version"
        "kimi:Kimi:kimi --version"
        "codex:Codex:codex --version"
    )

    for entry in "${agents[@]}"; do
        IFS=':' read -r cmd name check <<< "$entry"
        # Use timeout to prevent hanging on slow/interactive commands
        if timeout 3 bash -c "$check" &>/dev/null 2>&1; then
            echo -e "  ${GREEN}✓${NC} $name ($cmd)"
        else
            echo -e "  ${RED}✗${NC} $name ($cmd) - not installed"
        fi
    done
    echo ""
}

# No arguments - launch default agent
if [[ $# -eq 0 ]]; then
    if command -v "$DEFAULT_AGENT" &>/dev/null; then
        exec "$DEFAULT_AGENT"
    else
        echo -e "${RED}Error: Default agent '$DEFAULT_AGENT' not found${NC}"
        echo "Set AI_DEFAULT_AGENT or install claude: brew install claude"
        exit 1
    fi
fi

# Handle flags
case "$1" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    -l|--list|list)
        list_agents
        exit 0
        ;;
esac

# Agent selection
agent="$1"
shift

case "$agent" in
    # Claude Code
    claude|c)
        if command -v claude &>/dev/null; then
            exec claude "$@"
        else
            echo -e "${RED}Claude Code not installed${NC}"
            echo "Install: brew install claude"
            exit 1
        fi
        ;;
    
    # Cursor Agent
    cursor|agent|cu)
        if command -v agent &>/dev/null; then
            exec agent "$@"
        elif [[ -d "/Applications/Cursor.app" ]]; then
            exec open -a Cursor "$@"
        else
            echo -e "${RED}Cursor Agent not installed${NC}"
            echo "Install: curl https://cursor.com/install -fsS | bash"
            exit 1
        fi
        ;;
    
    # Aider
    aider|a)
        if command -v aider &>/dev/null; then
            exec aider "$@"
        else
            echo -e "${RED}Aider not installed${NC}"
            echo "Install: uv tool install aider-chat"
            exit 1
        fi
        ;;
    
    # OpenCode
    opencode|oc)
        if command -v opencode &>/dev/null; then
            exec opencode "$@"
        else
            echo -e "${RED}OpenCode not installed${NC}"
            echo "Install: brew install anomalyco/tap/opencode"
            exit 1
        fi
        ;;
    
    # Amp
    amp)
        if command -v amp &>/dev/null; then
            exec amp "$@"
        else
            echo -e "${RED}Amp not installed${NC}"
            echo "Install: curl -fsSL https://ampcode.com/install.sh | bash"
            exit 1
        fi
        ;;
    
    # Pi
    pi)
        if command -v pi &>/dev/null; then
            exec pi "$@"
        else
            echo -e "${RED}Pi not installed${NC}"
            echo "Install: npm i -g @mariozechner/pi-coding-agent"
            exit 1
        fi
        ;;
    
    # Gemini
    gemini|g)
        if command -v gemini &>/dev/null; then
            exec gemini "$@"
        else
            echo -e "${RED}Gemini CLI not installed${NC}"
            echo "Install: npm i -g @google/generative-ai-cli"
            exit 1
        fi
        ;;
    
    # Kimi
    kimi)
        if command -v kimi &>/dev/null; then
            exec kimi "$@"
        else
            echo -e "${RED}Kimi not installed${NC}"
            echo "Install: uv tool install kimi-cli"
            exit 1
        fi
        ;;
    
    # Codex (OpenAI)
    codex|cx)
        if command -v codex &>/dev/null; then
            exec codex "$@"
        else
            echo -e "${RED}Codex not installed${NC}"
            echo "Install: npm i -g @openai/codex"
            exit 1
        fi
        ;;
    
    *)
        echo -e "${RED}Unknown agent: $agent${NC}"
        echo "Run 'ai --help' for available agents"
        exit 1
        ;;
esac
