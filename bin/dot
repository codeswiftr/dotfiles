#!/usr/bin/env bash
# ============================================================================
# DOT CLI - Ultimate Development Environment Orchestrator
# The single command to rule them all
# ============================================================================

set -euo pipefail

# Handle Graphviz dot command conflict
if [[ $# -eq 0 ]] || [[ "$1" =~ ^-[VvGNETKlosxnLPqscyO?] ]]; then
    # If no arguments or arguments look like Graphviz dot flags, delegate to system dot
    if command -v /opt/homebrew/bin/dot >/dev/null 2>&1; then
        exec /opt/homebrew/bin/dot "$@"
    elif command -v /usr/bin/dot >/dev/null 2>&1; then
        exec /usr/bin/dot "$@"
    else
        echo "Error: Graphviz dot command not found. Install with: brew install graphviz" >&2
        exit 1
    fi
fi

# Configuration
# Resolve repository root based on this script location, unless explicitly provided
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
DOT_VERSION="1.0.0"
DOT_CLI_DIR="$DOTFILES_DIR/lib/cli"

# Colors and emojis
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

SUCCESS="✅"
ERROR="❌"
INFO="ℹ️"
ROCKET="🚀"
GEAR="⚙️"
LOCK="🔒"
TEST="🧪"
AI="🤖"
PROJECT="📁"

# Utility functions
print_success() { echo -e "${GREEN}${SUCCESS} $1${NC}"; }
print_error() { echo -e "${RED}${ERROR} $1${NC}"; }
print_info() { echo -e "${BLUE}${INFO} $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠️  $1${NC}"; }

# Help system
show_help() {
    cat << 'EOF'
🚀 DOT CLI - Development Environment Manager

USAGE: dot <command> [options]

ESSENTIAL COMMANDS:
  setup       Setup environment (idempotent)
  check       Health check (-m for JSON output)
  update      Update everything (-m for JSON)
  doctor      Diagnose and fix common issues
  new         Create new project (alias: project init)

DEVELOPMENT:
  run         Run dev/test/prod environments
  test        Run tests (all-in-one: test/quick/watch)
  ai          AI assistant (review/test/commit)
  git         Git helpers (workflow/branch/sign)

TOOLS:
  install     Install tools (use: dot install <tool>)
  dev         Dev containers & environments
  db          Database management

OPTIONS:
  -h, --help      Show help
  -v, --version   Show version
  --machine, -m   Machine-readable JSON output
  --yes, -y       Auto-confirm prompts

EXAMPLES:
  dot setup                 # First-time setup
  dot check -m              # Health check (JSON)
  dot new fastapi my-api    # Create FastAPI project
  dot install ai_tools      # Install all AI CLIs
  dot doctor                # Fix common issues

For full help: dot --help-all
EOF
}

# Extended help (all commands)
show_help_all() {
    cat << 'EOF'
🚀 DOT CLI - Complete Command Reference

CORE COMMANDS:
  setup, check, update, reload, version, doctor

DEVELOPMENT:
  new <type> [name]         Create project (alias for project init)
  project                   Project management
    init [type] [name]      Create from template
    list                    List templates
  run                       Process management
    dev/test/prod           Environment modes
  test                      Testing framework
    run/quick/watch/coverage

AI:
  ai                        AI development assistant
    review                  Code review
    test                    Generate tests
    commit                  Smart commit messages

SECURITY:
  security                  Security operations
    scan                    Security audit
    deps                    Check dependencies
  secret                    Secret management

CONFIG:
  config                    Configuration
    theme/tools/security
  template                  Templates
    generate/process/create

DATABASE:
  db                        Database management
    setup/seed/reset

DEV:
  dev                       Dev containers (short for devcontainer)
    init/build/up/exec

GIT:
  git                       Git operations
    workflow/branch/sign

TOOLS:
  install <tool|group>      Install tools from config/tools.yaml

GLOBAL OPTIONS:
  -h, --help          Show help
  --help-all          Show this full help
  -v, --version       Show version
  -m, --machine       Machine-readable JSON output
  --verbose           Verbose output
  --yes, -y           Auto-confirm

DOCUMENTATION:
    docs               Documentation system
        generate           Generate documentation
        build [format]     Build documentation site
        serve [port]       Serve documentation locally
        interactive        Interactive help system

BACKUP & RESTORE:
    backup             Backup and restore system
        create [type]      Create backup (full/incremental/config)
        restore [name]     Restore from backup
        list [filter]      List available backups
        schedule           Manage automated backups

MIGRATION & UPGRADE:
    migrate            Migration and upgrade system
        status             Check migration status
        migrate [version]  Run migration to target version
        rollback [backup]  Rollback to previous state
        backup [version]   Create manual backup

PLATFORM MANAGEMENT:
    platform           Cross-platform configuration and optimization
        config [level]     Platform-specific optimizations (auto|balanced|performance)
        tools [action]     Platform tool management (install|update|list|sync)
        performance [prof] Performance tuning (auto|high|balanced|development)
        migrate [action]   Cross-platform migration (export|import|migrate|compare)
        status             Platform compatibility check

OPTIONS:
    -h, --help         Show this help message
    -v, --version      Show version information
    --verbose          Enable verbose output
    --dry-run          Show what would be done

EXAMPLES:
    dot setup                     # Setup development environment
    dot project init fastapi my-api  # Create new FastAPI project
    dot project init fullstack app   # Create full-stack project
    dot ai commit --auto          # AI-powered commit with auto-approval
    dot ai analyze security       # AI security analysis
    dot ai debug "import error"   # Debug errors with AI
    dot secret exec -- npm start # Run with injected secrets
    dot security scan            # Security audit
    dot perf optimize            # Optimize performance

For detailed help on any command:
    dot <command> --help

Documentation: https://github.com/user/dotfiles/docs/cli.md
EOF
}

# Version information
show_version() {
    echo "🚀 DOT CLI v${DOT_VERSION}"
    echo "📍 Dotfiles: ${DOTFILES_DIR}"
    echo "📦 Last update: $(date -r ~/.zshrc "+%Y-%m-%d" 2>/dev/null || stat -c %y ~/.zshrc 2>/dev/null | cut -d' ' -f1 || echo 'Unknown')"
    
    if [[ -f "$DOTFILES_DIR/VERSION" ]]; then
        echo "🏷️  Environment: v$(cat "$DOTFILES_DIR/VERSION")"
    fi
}

# Load CLI libraries
load_cli_lib() {
    local lib_file="$DOT_CLI_DIR/$1.sh"
    if [[ -f "$lib_file" ]]; then
        source "$lib_file"
    else
        print_error "CLI library not found: $1"
        exit 1
    fi
}

# Main command dispatcher
main() {
    # Handle global options (before command)
    local machine_mode=false
    local show_help_all=false
    
    # Parse leading flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            --help-all)
                show_help_all
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            -m|--machine)
                machine_mode=true
                shift
                ;;
            "")
                show_help
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done

    local command="$1"
    shift
    
    # Prepend --machine if machine_mode is enabled
    if [[ "$machine_mode" == "true" ]]; then
        set -- --machine "$@"
    fi

    # Command routing
    case "$command" in
        # Core commands
        "setup")
            load_cli_lib "core"
            dot_setup "$@"
            ;;
        "check")
            load_cli_lib "core"
            dot_check "$@"
            ;;
        "update")
            load_cli_lib "core"
            dot_update "$@"
            ;;
        "doctor")
            load_cli_lib "core"
            dot_doctor "$@"
            ;;
        "init")
            # One-shot initialization: link configs and run health check
            # Options:
            #   --json    Output health as JSON (skip linking noise)
            local init_json=false
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json)
                        init_json=true
                        shift
                        ;;
                    *)
                        break
                        ;;
                esac
            done

            if [[ "$init_json" == "true" ]]; then
                # Pure JSON health (no extra output)
                if [[ -f "$DOTFILES_DIR/scripts/health-check.sh" ]]; then
                    "$DOTFILES_DIR/scripts/health-check.sh" --json
                    exit 0
                else
                    # Fallback: minimal JSON stub
                    echo '{"error":"health-check script not found"}'
                    exit 1
                fi
            fi

            load_cli_lib "core"
            if [[ -f "$DOTFILES_DIR/install.sh" ]]; then
                print_info "${GEAR} Linking dotfiles configuration..."
                bash "$DOTFILES_DIR/install.sh" --dry-run link >/dev/null 2>&1 || true
                bash "$DOTFILES_DIR/install.sh" link || print_warning "Linking reported warnings"
            else
                print_warning "Installer not found; proceeding to health check"
            fi
            if [[ -f "$DOTFILES_DIR/scripts/health-check.sh" ]]; then
                print_info "${GEAR} Running health check..."
                "$DOTFILES_DIR/scripts/health-check.sh"
            else
                dot_check
            fi
            ;;
        "reload")
            # Best-effort reload of runtime-managed configs.
            # Note: re-sourcing the parent shell (e.g., ~/.zshrc) must be done from the shell process.
            # A zsh wrapper function is provided in config/zsh/functions.zsh to handle that automatically
            # when you run `dot reload`. Here we refresh external daemons and tmux config.
            if command -v tmux >/dev/null 2>&1; then
                tmux source-file "$HOME/.tmux.conf" 2>/dev/null || true
                print_info "Reloaded tmux configuration"
            fi
            if command -v mise >/dev/null 2>&1; then
                mise reshim >/dev/null 2>&1 || true
                print_info "Refreshed mise shims"
            fi
            print_info "If your shell environment did not refresh, run: source ~/.zshrc"
            ;;
        "version")
            show_version
            ;;

        # Development commands
        "new")
            # Shortcut: dot new <type> [name] -> dot project init <type> [name]
            load_cli_lib "project"
            dot_project init "$@"
            ;;
        "project")
            load_cli_lib "project"
            dot_project "$@"
            ;;
        "run")
            load_cli_lib "process"
            dot_run "$@"
            ;;
        "process"|"proc")
            load_cli_lib "process"
            dot_run "$@"
            ;;
        "install")
            # Install tools: dot install <tool|group>
            if [[ -f "$DOTFILES_DIR/install.sh" ]]; then
                bash "$DOTFILES_DIR/install.sh" install "$@"
            else
                print_error "Installer not found"
                exit 1
            fi
            ;;

        # Security commands
        "secret")
            load_cli_lib "secret"
            dot_secret "$@"
            ;;
        "security")
            load_cli_lib "security"
            dot_security "$@"
            ;;

        # AI commands
        "ai")
            load_cli_lib "ai"
            dot_ai "$@"
            ;;

        # Testing commands
        "test"|"testing")
            load_cli_lib "testing"
            dot_testing "$@"
            ;;

        # Performance commands
        "perf")
            load_cli_lib "performance"
            dot_perf "$@"
            ;;
        "nvim")
            load_cli_lib "performance"
            if declare -f dot_nvim >/dev/null 2>&1; then
              dot_nvim "$@"
            else
              print_error "dot_nvim not available"
              exit 1
            fi
            ;;

        # Configuration commands
        "config")
            load_cli_lib "config"
            dot_config "$@"
            ;;

        # Template commands
        "template")
            source "$DOTFILES_DIR/lib/templating.sh"
            template_cli "$@"
            ;;

        # Database commands
        "db")
            load_cli_lib "database"
            dot_db "$@"
            ;;

        # Git commands
        "git")
            load_cli_lib "git"
            dot_git "$@"
            ;;

        # DevContainer commands
        "dev"|"devcontainer")
            load_cli_lib "devcontainer"
            dot_devcontainer "$@"
            ;;

        # Documentation commands
        "docs")
            source "$DOTFILES_DIR/lib/documentation.sh"
            docs_cli "$@"
            ;;

        # Platform management commands (Epic 7.1)
        "platform")
            source "$DOTFILES_DIR/lib/platform.sh"
            case "${1:-status}" in
                "config")
                    platform_config_optimization "${2:-auto}" "${3:-}"
                    ;;
                "tools")
                    platform_tool_management "${2:-status}" "${3:-}" "${4:-}"
                    ;;
                "performance")
                    platform_performance_tuning "${2:-auto}" "${3:-false}"
                    ;;
                "migrate")
                    platform_migration_tools "${2:-status}" "${3:-}" "${4:-}"
                    ;;
                "status")
                    check_platform_compatibility
                    ;;
                *)
                    echo "Platform management commands:"
                    echo "  dot platform config [level]     - Platform-specific optimizations"
                    echo "  dot platform tools [action]     - Platform tool management"
                    echo "  dot platform performance [profile] - Performance tuning"
                    echo "  dot platform migrate [action]   - Cross-platform migration"
                    echo "  dot platform status             - Platform compatibility check"
                    ;;
            esac
            ;;

        # Health command
        "health")
            # Options: --json to output JSON via health-check script
            case "${1:-}" in
                --json)
                    if [[ -f "$DOTFILES_DIR/scripts/health-check.sh" ]]; then
                        "$DOTFILES_DIR/scripts/health-check.sh" --json
                    else
                        echo '{"error":"health-check script not found"}'
                        exit 1
                    fi
                    ;;
                *)
                    if [[ -f "$DOTFILES_DIR/scripts/health-check.sh" ]]; then
                        "$DOTFILES_DIR/scripts/health-check.sh"
                    else
                        load_cli_lib "core"
                        dot_check
                    fi
                    ;;
            esac
            ;;

        # Unknown command
        *)
            print_error "Unknown command: $command"
            echo ""
            echo "Run 'dot --help' for available commands."
            exit 1
            ;;
    esac
}

# Error handling
trap 'print_error "An error occurred. Use --verbose for more details."; exit 1' ERR

# Run main function
main "$@"