#!/usr/bin/env bash
# ============================================================================
# DOT CLI — development environment manager
# ============================================================================

set -euo pipefail

# Handle Graphviz dot command conflict
if [[ $# -eq 0 ]] || [[ "$1" =~ ^-[VvGNETKlosxnLPqscyO?] ]]; then
    if command -v /opt/homebrew/bin/dot >/dev/null 2>&1; then
        exec /opt/homebrew/bin/dot "$@"
    elif command -v /usr/bin/dot >/dev/null 2>&1; then
        exec /usr/bin/dot "$@"
    else
        echo "Error: Graphviz dot command not found. Install with: brew install graphviz" >&2
        exit 1
    fi
fi

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
DOT_VERSION="1.0.0"
DOT_CLI_DIR="$DOTFILES_DIR/lib/cli"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'
SUCCESS="✅"
ERROR="❌"
INFO="ℹ️"

print_success() { echo -e "${GREEN}${SUCCESS} $1${NC}"; }
print_error() { echo -e "${RED}${ERROR} $1${NC}"; }
print_info() { echo -e "${BLUE}${INFO} $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠️  $1${NC}"; }

show_help() {
    cat << 'EOF'
DOT CLI — development environment manager

USAGE: dot <command> [options]

COMMANDS:
  setup       First-time / force setup
  check       Health check (--fix, -m JSON)
  update      Pull + relink + tool upgrades (--self | --tools)
  reload      Reload Herdr config / mise shims
  restart     Herdr workspace + agent status
  test        Run bats suite (or: just smoke / just test)
  install     Install tool/group via install.sh
  doctor      Alias for check --fix

ALSO:  docs | security | git | ai | config

OPTIONS:
  -h, --help      Show help
  -v, --version   Show version
  -m, --machine   JSON where supported

EXAMPLES:
  ./install.sh              # memorable fresh install (standard profile)
  dot check -m
  dot update --self
  dot test
  just smoke

Layout: ARCHITECTURE.md · Agents: AGENTS.md · Docs: docs/README.md
EOF
}

show_version() {
    echo "DOT CLI v${DOT_VERSION}"
    echo "Dotfiles: ${DOTFILES_DIR}"
    if [[ -f "$DOTFILES_DIR/VERSION" ]]; then
        echo "Environment: v$(cat "$DOTFILES_DIR/VERSION")"
    fi
}

load_cli_lib() {
    local lib_file="$DOT_CLI_DIR/$1.sh"
    if [[ -f "$lib_file" ]]; then
        source "$lib_file"
    else
        print_error "CLI library not found: $1"
        exit 1
    fi
}

dot_test_bats() {
    if ! command -v bats >/dev/null 2>&1; then
        print_error "bats not installed. Install: brew install bats-core"
        exit 1
    fi
    local target="${1:-}"
    case "$target" in
        ""|all)
            bats "$DOTFILES_DIR"/tests/bats/*.bats
            ;;
        smoke|quick)
            bats "$DOTFILES_DIR/tests/bats/smoke.bats"
            ;;
        infra|infrastructure)
            bats "$DOTFILES_DIR/tests/bats/infrastructure.bats"
            ;;
        -h|--help|help)
            echo "Usage: dot test [all|smoke|infra]"
            echo "Prefer: just smoke | just test"
            ;;
        *)
            bats "$DOTFILES_DIR/tests/bats/$target" 2>/dev/null \
                || bats "$DOTFILES_DIR"/tests/bats/*.bats "$@"
            ;;
    esac
}

main() {
    local machine_mode=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help|--help-all)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            -m|--machine)
                machine_mode=true
                shift
                ;;
            "")
                show_help
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done

    local command="${1:-}"
    [[ -n "$command" ]] || { show_help; exit 0; }
    shift

    if [[ "$machine_mode" == "true" ]]; then
        set -- --machine "$@"
    fi

    case "$command" in
        setup|init)
            load_cli_lib "core"
            dot_setup "$@"
            ;;
        check|health)
            load_cli_lib "core"
            dot_check "$@"
            ;;
        update)
            load_cli_lib "core"
            dot_update "$@"
            ;;
        doctor)
            load_cli_lib "core"
            dot_check --fix "$@"
            ;;
        reload)
            if command -v herdr >/dev/null 2>&1; then
                if herdr server reload-config >/dev/null 2>&1; then
                    print_info "Reloaded Herdr configuration"
                fi
            fi
            if command -v mise >/dev/null 2>&1; then
                mise reshim >/dev/null 2>&1 || true
                print_info "Refreshed mise shims"
            fi
            print_info "If your shell environment did not refresh, run: source ~/.zshrc"
            ;;
        restart)
            if ! command -v herdr >/dev/null 2>&1; then
                print_error "Herdr required. Install: ./install.sh   then use: hw  ha  hl"
                exit 1
            fi
            case "${1:-status}" in
                -h|--help|help|status|"")
                    herdr workspace list
                    herdr agent list
                    ;;
                *)
                    print_error "Unknown restart action: $1"
                    print_info "Usage: dot restart   # Herdr workspace + agent status"
                    exit 1
                    ;;
            esac
            ;;
        version)
            show_version
            ;;
        install)
            if [[ -f "$DOTFILES_DIR/install.sh" ]]; then
                bash "$DOTFILES_DIR/install.sh" install "$@"
            else
                print_error "Installer not found"
                exit 1
            fi
            ;;
        test|testing)
            dot_test_bats "$@"
            ;;
        security)
            load_cli_lib "security"
            dot_security "$@"
            ;;
        ai)
            load_cli_lib "ai"
            dot_ai "$@"
            ;;
        config)
            load_cli_lib "config"
            dot_config "$@"
            ;;
        git)
            load_cli_lib "git"
            dot_git "$@"
            ;;
        docs)
            if [[ -f "$DOTFILES_DIR/lib/documentation.sh" ]]; then
                source "$DOTFILES_DIR/lib/documentation.sh"
                docs_cli "$@"
            else
                print_info "See docs/README.md"
            fi
            ;;
        new|project|perf|nvim|template|platform)
            print_error "Removed: 'dot $command' (legacy)."
            print_info "Use: ./install.sh | just smoke | nvim :TierUp | ai --help"
            exit 1
            ;;
        *)
            print_error "Unknown command: $command"
            echo ""
            echo "Run 'dot --help' for available commands."
            exit 1
            ;;
    esac
}

trap 'print_error "An error occurred."; exit 1' ERR
main "$@"
