#!/bin/sh
set -eu

# Portable cursor-agent wrapper
# Dynamically finds the latest installed version

# Prefer cursor-agent if directly available
if command -v cursor-agent >/dev/null 2>&1; then
  exec cursor-agent "$@"
fi

# Check common Cursor app bundle locations
for candidate in \
  "$HOME/Applications/Cursor.app/Contents/Resources/app/bin/cursor-agent" \
  "/Applications/Cursor.app/Contents/Resources/app/bin/cursor-agent"; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

# Find latest cursor-agent version
CURSOR_AGENT_DIR="${HOME}/.local/share/cursor-agent/versions"

if [ -d "$CURSOR_AGENT_DIR" ]; then
  # Get the latest version directory (sorted by modification time)
  LATEST=$(ls -t "$CURSOR_AGENT_DIR" 2>/dev/null | head -1)
  if [ -n "$LATEST" ] && [ -x "$CURSOR_AGENT_DIR/$LATEST/cursor-agent" ]; then
    exec "$CURSOR_AGENT_DIR/$LATEST/cursor-agent" "$@"
  fi
fi

# Fallback: try cursor agent subcommand
if command -v cursor >/dev/null 2>&1; then
  exec cursor agent "$@"
fi

echo "Error: cursor-agent not found. Install Cursor IDE from https://cursor.com" >&2
exit 1
