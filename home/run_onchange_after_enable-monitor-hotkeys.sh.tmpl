#!/usr/bin/env bash
# Idempotently enable the monitor-input Karabiner rule.
# Raycast hotkeys cannot be set from disk (encrypted prefs); Karabiner can.
#
# Re-runs when the rule JSON changes:
# checksum: {{ output "shasum" "-a" "256" (joinPath .chezmoi.sourceDir ".." "config" "karabiner" "complex_modifications" "monitor-input.json") | trim | splitList " " | first }}
set -euo pipefail

KB="${HOME}/.config/karabiner/karabiner.json"
ASSET="${HOME}/.config/karabiner/assets/complex_modifications/monitor-input.json"
DESC='Monitor input: USB-C (⌥⌘U) / HDMI (⌥⌘H)'

[[ -f "$ASSET" ]] || exit 0
[[ -f "$KB" ]] || exit 0

python3 - "$KB" "$ASSET" "$DESC" <<'PY'
import json, sys, shutil
from pathlib import Path

kb_path, asset_path, desc = map(Path, sys.argv[1:4])
kb = json.loads(kb_path.read_text())
asset = json.loads(asset_path.read_text())

rule = next((r for r in asset.get("rules", []) if r.get("description") == desc), None)
if rule is None and asset.get("rules"):
    rule = asset["rules"][0]
    desc = rule.get("description", desc)
if rule is None:
    sys.exit(0)

changed = False
for profile in kb.get("profiles", []):
    cm = profile.setdefault("complex_modifications", {})
    rules = cm.setdefault("rules", [])
    for i, existing in enumerate(rules):
        if existing.get("description") == desc:
            if existing != rule:
                rules[i] = rule
                changed = True
            break
    else:
        rules.append(rule)
        changed = True

if not changed:
    sys.exit(0)

backup = kb_path.with_suffix(".json.bak-dotfiles")
shutil.copy2(kb_path, backup)
kb_path.write_text(json.dumps(kb, indent=4) + "\n")
print(f"Enabled Karabiner rule: {desc}")
PY
