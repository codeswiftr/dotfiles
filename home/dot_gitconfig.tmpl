# Git Configuration - managed by chezmoi
# Edit source: chezmoi edit ~/.gitconfig
{{ $name := get . "name" | default "" -}}
{{- $email := get . "email" | default "" -}}
{{- if or $name $email }}
[user]
{{- if $name }}
    name = {{ $name }}
{{- end }}
{{- if $email }}
    email = {{ $email }}
{{- end }}
{{- else }}
# [user] not set — run `chezmoi init` or put a [user] block in ~/.gitconfig.local
{{- end }}

[core]
    editor = nvim
    autocrlf = false
    hooksPath = ~/.config/git/hooks

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = simple
    autoSetupRemote = true

[merge]
    tool = vimdiff

[diff]
    tool = vimdiff

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    df = diff
    lg = log --oneline --graph --decorate --all
    unstage = reset HEAD --
    last = log -1 HEAD
    aa = add --all
    cm = commit -m
    ca = commit -am
    ps = push
    pl = pull
    branches = branch -a
    remotes = remote -v
    hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
    sl = stash list
    sa = stash apply
    ss = stash save

{{ if eq .chezmoi.os "darwin" -}}
[credential]
    helper = osxkeychain
{{ else -}}
[credential]
    helper = store
{{ end -}}

[gpg]
    program = gpg

# Include local git config if it exists
[include]
    path = ~/.gitconfig.local
